{
  "name": "auditoria",
  "version": "1.0.0",
  "description": "Aegis CyberAudit - plataforma de auditoria de ciberseguridad (MVP)",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "worker:scan": "tsx watch src/jobs/scanWorker.ts",
    "worker:retention": "tsx watch src/jobs/retentionWorker.ts",
    "worker:economic-indicators": "tsx watch src/jobs/economicIndicatorsWorker.ts",
    "db:migrate": "tsx db/run-migrations.ts",
    "admin:promote": "tsx db/promote-admin.ts",
    "storage:setup": "tsx db/setup-storage.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonB3215/auditoria.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/simonB3215/auditoria/issues"
  },
  "homepage": "https://github.com/simonB3215/auditoria#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "bullmq": "^6.0.6",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "file-type": "^22.0.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "multer": "^2.2.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/exceljs": "^0.5.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3"
  }
}
