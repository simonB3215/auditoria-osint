# Copiar a .env y completar. Los valores acá son placeholders — ninguno es
# una credencial real. Fuente de verdad de qué es obligatorio y qué tiene
# default: src/config/env.ts (schema de Zod).

# --- Servidor ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001

# --- Supabase — Project Settings > API Keys ---
# https://supabase.com/dashboard/project/_/settings/api-keys
SUPABASE_URL=https://xxxxx.supabase.co
# Publishable key (sb_publishable_...). Si tu proyecto es viejo y todavía
# no migró, también funciona la "anon key" legacy (pestaña "Legacy API Keys").
SUPABASE_ANON_KEY=change-me
# Secret key (sb_secret_...), o la "service_role key" legacy. NUNCA exponer
# esta al frontend ni a un NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=change-me

# --- Postgres — Project Settings > Database > Connection string > URI ---
# (conexión directa, puerto 5432; reemplazar [YOUR-PASSWORD] por el password real)
# REQUERIDA (validada en src/config/env.ts). Hoy solo la lee
# `npm run db:migrate` (db/run-migrations.ts) para aplicar db/schema.sql y
# las migraciones — la API no la usa en runtime — pero se valida igual al
# arrancar cualquier cosa, para no descubrir que falta recién al migrar.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres

# --- Redis (BullMQ — motor de escaneo asíncrono) ---
REDIS_URL=redis://localhost:6379

# --- Storage ---
EVIDENCE_BUCKET=evidences
REPORTS_BUCKET=reports
# Clave AES-256 (32 bytes) en hex, para cifrar evidencias antes de subirlas a
# Storage. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EVIDENCE_ENCRYPTION_KEY=change-me-64-hex-chars

# --- Reglas de negocio ---
# Límite duro de activos por organización (plan MVP). Opcional: si no se
# define, el default del schema es 5.
MAX_ASSETS_PER_ORG=5
# Máximo de escaneos simultáneos (queued/running) por organización, para
# que un solo tenant no monopolice los slots de concurrency del worker.
# Opcional, default 2.
MAX_CONCURRENT_SCANS_PER_ORG=2
# Cuántos puertos más comunes escanea nmap (--top-ports). Opcional,
# default 1000, tope máximo duro 5000.
SCAN_TOP_PORTS=1000

# --- Email transaccional (Resend) — OPCIONAL ---
# Opcional en el schema de Zod a propósito: si se omite, el envío de emails
# queda en modo "preparado pero no conectado" (el contenido se registra en
# consola en vez de enviarse) — ver src/services/emailTemplates.ts. El
# servidor arranca igual sin esta variable.
RESEND_API_KEY=change-me
